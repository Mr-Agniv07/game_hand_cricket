# Production build config (used by `vite build`, i.e. `pnpm build`).
# The Android app bundles this build and loads it from local files, so the server
# URL must be an absolute https:// URL — a relative/empty value or localhost won't
# reach the server from a device. This is your live Render backend.
VITE_SERVER_URL=https://cric-flick.onrender.com
